# Public site URL (no trailing slash) — used for SEO canonical and Open Graph links
VITE_SITE_URL=https://www.markshelland.com

# Contact form API (defaults to /api/contact)
# VITE_CONTACT_API=/api/contact

# Career application API (defaults to /api/career-apply)
# VITE_CAREER_APPLY_API=/api/career-apply

# SMTP settings for contact & career emails (server-side only — do NOT prefix with VITE_)
# Gmail example: enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=markshellassociates@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=markshellassociates@gmail.com
CONTACT_NOTIFY_EMAIL=markshellassociates@gmail.com
CAREER_NOTIFY_EMAIL=markshellassociates@gmail.com
