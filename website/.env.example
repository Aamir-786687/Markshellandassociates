# Public site URL (no trailing slash) — used for SEO canonical and Open Graph links
VITE_SITE_URL=https://www.markshelland.com

# Contact form (Web3Forms or Formspree). Leave empty to disable live submissions.
# Web3Forms example:
# VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
# VITE_CONTACT_FORM_ACCESS_KEY=your-web3forms-access-key

# Formspree example:
# VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id
