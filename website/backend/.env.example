# MongoDB connection string — add your URI here
MONGODB_URI=mongodb://localhost:27017/markshell

# Server port
PORT=5000

# Comma-separated frontend URLs allowed to call the API
# Development: localhost is allowed automatically
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Production example:
# NODE_ENV=production
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
